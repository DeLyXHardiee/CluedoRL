{
  "name": "cluedo-arena-public",
  "version": "1.0.0",
  "description": "A deterministic heuristic simulation of the game Cluedo (Clue).",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --ignore '*.log' --ignore 'logs/*' --ignore 'game_results.json' src/index.js",
    "test": "node --test ../tests/*.test.js",
    "run-games": "node src/index.js --run-games",
    "run-games:3": "node src/index.js --run-games --num-games=3",
    "run-games:heuristic": "node src/index.js --run-games --num-games=3 --heuristic-strategy=focused-smart-gamble2"
  },
  "keywords": [
    "cluedo",
    "clue",

    "ai",
    "simulation",
    "benchmark"
  ],
  "author": "Batuhan Aktas",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "express": "^4.18.2",
    "mongoose": "^8.0.2",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1"
  }
}
